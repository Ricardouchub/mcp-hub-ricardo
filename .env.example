# Google OAuth: ruta al JSON de cliente OAuth
GOOGLE_CREDENTIALS_PATH=secrets/credentials.google.json
GOOGLE_TOKEN_PATH=data/token.google.json
# Scopes (separados por espacios; puedes afinarlos)
